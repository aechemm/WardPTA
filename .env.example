# Copy to .dev.vars for local `wrangler pages dev` (never commit real values).
# Also set these in Cloudflare Pages → Settings → Environment variables
# for Production and Preview.

APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
API_SECRET=generate-a-long-random-string-and-store-the-same-value-in-Apps-Script-Properties
